/// @description What fish a room's water has: "sea", "river", or undefined (ponds).
function world_water(_name){
	static t = {rm_bunny: "sea", rm_phoenix: "sea", rm_beirut: "sea", rm_mountain: "river", rm_sunset: "sea", rm_outskirts: "river", rm_woods: "river", rm_countryside: "river"};
	return t[$ _name];
}

/// @description The room an old room's name now means (rm_downtown -> rm_beirut), or the name itself. Its spots are
/// in that room as "<old room>__<spot>" (layout_point and sched_place look there).
function world_alias(_name){
	static t = {rm_wellshead: "rm_beirut", rm_redstreet: "rm_beirut", rm_downtown: "rm_beirut", rm_gracetower: "rm_beirut", rm_verdun: "rm_beirut", rm_uptown: "rm_beirut", rm_ovenswindow: "rm_beirut", rm_manara: "rm_beirut", rm_starsand: "rm_phoenix", rm_hangar: "rm_phoenix", rm_plummet: "rm_mountain", rm_beaconhill: "rm_mountain", rm_victoryhill: "rm_mountain", rm_pigeonrocks: "rm_beirut", rm_whitesand: "rm_sunset", rm_olivebay: "rm_sunset", rm_southbeach: "rm_sunset", rm_winghill: "rm_outskirts", rm_dahya: "rm_outskirts", rm_resolve: "rm_outskirts", rm_yarzeh: "rm_woods", rm_1: "rm_1", rm_sthereza: "rm_countryside", rm_frere: "rm_countryside", rm_abda: "rm_countryside"};
	return t[$ _name] ?? _name;
}

/// @description Whether a cell of an outdoor room is road (cobbles), for the player's road boost.
function world_is_road(_name, _cx, _cy){
	static t = {
		rm_bunny: {w: 49, grid: ""},
		rm_phoenix: {w: 167, grid: ""},
		rm_beirut: {w: 137, grid: ""},
		rm_mountain: {w: 114, grid: ""},
		rm_sunset: {w: 45, grid: ""},
		rm_outskirts: {w: 108, grid: ""},
		rm_woods: {w: 98, grid: ""},
		rm_countryside: {w: 101, grid: ""},
	};
	var r = t[$ _name];
	if(r == undefined || _cx < 0 || _cy < 0 || _cx >= r.w) return false;
	var i = _cy * r.w + _cx;
	return i < string_length(r.grid) && string_char_at(r.grid, i + 1) == "1";
}

/// @description The cable car's and the tram's stations (scripts/transit): kind, stop name, room and where you arrive.
